NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_REFRESH_INTERVAL_MS=30000
NEXT_PUBLIC_SESSION_TIMEOUT_MS=900000
# Sentry error monitoring (frontend). Blank = SDK stays disabled, no-op.
# Same var name is read server-side too (instrumentation.ts) — see
# docs/bible/13_DEPLOYMENT.md. Set in Vercel's project env vars for prod,
# NOT here — this file is only a local-dev template.
NEXT_PUBLIC_SENTRY_DSN=
# Optional — only needed for source-map upload during `next build` (readable
# stack traces in Sentry). Build succeeds without these; source maps just
# won't upload.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
